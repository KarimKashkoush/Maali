PORT=4000
NODE_ENV=development
DATABASE_URL=postgresql://classroom:CHANGE_ME@127.0.0.1:5432/classroom_ai
TEST_DATABASE_URL=postgresql://classroom:CHANGE_ME@127.0.0.1:5432/classroom_ai_test
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_UNIQUE_PASSWORD_12_CHARS_MIN
SESSION_SECRET=REPLACE_WITH_RANDOM_SECRET_32_CHARS_MINIMUM
RECOGNITION_API_KEY=REPLACE_WITH_RANDOM_SHARED_RECOGNITION_SECRET
RECOGNITION_URL=http://127.0.0.1:8001
STORAGE_PROVIDER=local
UPLOAD_DIR=./uploads
