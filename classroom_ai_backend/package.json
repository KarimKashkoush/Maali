{
  "name": "classroom-ai-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "migrate": "node --env-file-if-exists=.env src/migrate.js",
    "test": "node --env-file-if-exists=.env --test test/*.test.js",
    "db:start": "node --env-file-if-exists=.env scripts/start-postgres.mjs",
    "predev": "npm run db:start"
  },
  "dependencies": {
    "dotenv": "^18.0.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "luxon": "^3.7.2",
    "multer": "^2.4.0",
    "pg": "^8.23.0",
    "sharp": "^0.35.4",
    "zod": "^4.6.5"
  }
}
